0 = None
1 = (CONTACT/LOWER BURDEN): CONTACT, LRC, MRSA, VRE, MDRO, CRO, BEDBUGS, SCABIES
2 = (HIGHER PPE/ ENV BURDEN): MRC, HRC, CDIFF, CDIFF_R_O, DROPLET, COVID, R_O_COVID
3 = (AIRBORNE/ VERY HIGH BURDEN): TB_R_O, AIRBORNE

Turnover Risk
0 = No expected move
1 = Possible transfer
2 = Discharge or transfer today
3 = New admission today
4 = Admission + procedural + likely multiple transitions
